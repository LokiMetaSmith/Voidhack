run = "bash start_replit.sh"
entrypoint = "main.py"
modules = ["nodejs-20", "web", "python-3.12", "bash", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt"]

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "App Server"

[[workflows.workflow]]
name = "App Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd StarfleetComms_eval && npm run dev"
waitForPort = 5000

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "pip install -r requirements.txt && redis-server --port 6379 --bind 127.0.0.1 --requirepass ${REDIS_PASSWORD:-lcars_override_739} --daemonize yes && uvicorn main:app --host 0.0.0.0 --port 8000 & cd StarfleetComms_eval && node dist/index.js"]
build = ["npm", "run", "build"]

